  "baseline_method": "Restore the prior trajectory copy constructor and twice-restored batch transition behavior inside a separate pytest process. Adapt only the private _validate call to the explicit-state signature. Working-tree production files are not changed.",
  "baseline_script": "\"\"\"Restore the two pre-optimization behaviors only in this pytest process.\"\"\"\nimport sys\nfrom pathlib import Path\nroot=Path.cwd()\nfor directory in ('packages/stacking-common/src','apps/tabletop/src','apps/excavator/src'):\n    sys.path.insert(0,str(root/directory))\nfrom stacking_common.domain import StackObjectTrajectory\nfrom stacking_common.environment import SimulationTransition\n\n\ndef old_copy(self):\n    return StackObjectTrajectory(\n        object_id=self.object_id, poses=[pose.copy() for pose in self.poses],\n        energy=self.energy, vel_integral=self.vel_integral,\n        settle_pose_count=self.settle_pose_count,\n        settle_position_delta=self.settle_position_delta,\n        settle_path_length=self.settle_path_length,\n        times=None if self.times is None else self.times.copy())\n\n\ndef old_batch(self, states, actions):\n    if len(states)!=len(actions):\n        raise ValueError('transition batch states and actions must align')\n    prepared=[]\n    for state,action in zip(states,actions):\n        self.restore(state)\n        self._validate(action,self._state)\n        candidate=action.copy()\n        candidate.object_id=self.object_ids[candidate.object_index]\n        prepared.append(candidate)\n    results=self.backend.place_batch(states,prepared)\n    if len(results)!=len(prepared):\n        raise RuntimeError('placement batch returned the wrong number of results')\n    outputs=[]\n    for state,candidate,result in zip(states,prepared,results):\n        self.restore(state)\n        outputs.append(self._apply_result(candidate,result))\n    return tuple(outputs)\n\n\nStackObjectTrajectory.copy=old_copy\nSimulationTransition.step_batch=old_batch\nimport pytest\nraise SystemExit(pytest.main(sys.argv[1:]))\n",
  "command": "OPENBLAS_NUM_THREADS=1 OMP_NUM_THREADS=1 QT_QPA_PLATFORM=xcb xvfb-run -a python -m pytest -q --disable-warnings",
  "environment_note": "QT_QPA_PLATFORM=offscreen caused native X BadWindow termination; the isolated GUI test and full suite complete under Xvfb with xcb.",
  "regression_tests_added": [
    "checkpoint history remains independent of source and decoded state",
    "decode rejects nonfinite poses",
    "decode rejects zero quaternions",
    "decode rejects decreasing timestamps",
    "decode rejects negative trajectory IDs"
  ],
  "code_review": [
    "No production trajectory subclasses or other batch placement backends were found.",
    "Both platforms, planning checkpoints, and visualization use the shared copy path.",
    "All discovered trajectory producers construct validated values or use add_pose; CPU settling retains an already validated final pose and sets its structural time origin.",
    "CPU single-step restore/snapshot behavior is unchanged.",
    "Directly mutating an existing trajectory into an invalid state is no longer detected by copy; construction/add_pose/decode continue validating incoming data."
  ],
